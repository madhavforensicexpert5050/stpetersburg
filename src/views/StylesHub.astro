---
import { url } from '../lib/url.ts';
import MediaImage from '../components/MediaImage.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { styles } from '../data/taxonomy.ts';
import { getMedia } from '../data/media.ts';
import { isLive } from '../data/routes.ts';
import { stylesHub as c } from '../data/visual-pages.ts';

const nameOf = (id: string) => styles.find((s) => s.id === id)!.name;
/** Where a style name should link: its own page when built, else the filtered Design Library, else nowhere. */
const hrefOf = (id: string) => {
  const s = styles.find((x) => x.id === id)!;
  const page = `/design-styles/${id}/`;
  if (s.hasPage && isLive(page)) return page;
  return isLive('/design-library/') ? `/design-library/?style=${id}` : null;
};
const related = c.related.filter((r) => isLive(r.href));
---
<PageHero path="/design-styles/" eyebrow="Design styles" h1={c.h1} lede={c.lede} />

<section class="section section--tight">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">{c.cuesHead.eyebrow}</p><h2>{c.cuesHead.h}</h2><p>{c.cuesHead.p}</p></div>
    <div class="grid grid--4">
      {c.cues.map((x) => <div class="card card--flat"><h3>{x.h}</h3><p>{x.b}</p></div>)}
    </div>
  </div>
</section>

<section class="section section--wall">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Eight directions</p><h2>What each style brings to a room</h2></div>
    <div class="gal">
      {c.entries.map((e) => {
        const s = styles.find((x) => x.id === e.id)!;
        const img = getMedia(`lib-${s.id}-living-room`);
        const href = hrefOf(s.id);
        const ownPage = href === `/design-styles/${s.id}/`;
        return (
          <article class="gal__item" id={`style-${s.id}`}>
            {href ? <a href={url(href)} aria-label={`${s.name} style`}><MediaImage media={img} /></a> : <MediaImage media={img} />}
            <h3 style="font-size:1.4rem;margin-top:12px">{s.name}</h3>
            <p>{e.summary}</p>
            <p class="gal__meta"><strong>Look for:</strong> {e.lookFor}</p>
            {href && <a class="textlink small" href={url(href)}>{ownPage ? `More on ${s.name.toLowerCase()} staging` : `${s.name} rooms in the Design Library`}</a>}
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">{c.tableHead.eyebrow}</p><h2>{c.tableHead.h}</h2><p>{c.tableHead.p}</p></div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Design styles comparison table">
      <table style="min-width:760px">
        <caption>Mood, materials and fit for the eight staging styles</caption>
        <thead><tr><th scope="col">Style</th><th scope="col">Mood</th><th scope="col">Signature materials</th><th scope="col">Sits well with</th><th scope="col">Use with care when</th></tr></thead>
        <tbody>
          {c.entries.map((e) => <tr><th scope="row">{nameOf(e.id)}</th><td>{e.mood}</td><td>{e.signature}</td><td>{e.pairsWith}</td><td>{e.care}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section--wall">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">{c.situationsHead.eyebrow}</p><h2>{c.situationsHead.h}</h2><p>{c.situationsHead.p}</p></div>
    <div class="grid grid--3">
      {c.situations.map((x) => (
        <div class="card card--flat">
          <h3 style="font-size:1.15rem">{x.photo}</h3>
          <p class="gal__meta">Consider: {x.styles.map((id, i) => { const h = hrefOf(id); return <>{i > 0 && ', '}{h ? <a class="textlink" href={url(h)}>{nameOf(id)}</a> : nameOf(id)}</>; })}</p>
          <p>{x.why}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">{c.confusedHead.eyebrow}</p><h2>{c.confusedHead.h}</h2></div>
    <div class="grid grid--2">
      {c.confused.map((x) => <div class="card card--flat"><h3 style="font-size:1.2rem">{nameOf(x.a)} or {nameOf(x.b).toLowerCase()}?</h3><p>{x.body}</p></div>)}
    </div>
  </div>
</section>

<section class="section section--wall">
  <div class="wrap narrow">
    <div class="section-head"><p class="eyebrow">Questions</p><h2>Choosing a staging style: common questions</h2></div>
    <Faq items={c.faqs} />
    {related.length > 0 && (
      <nav class="related-links" aria-label="Related pages">
        <h2 style="font-size:1.15rem;margin:0 0 8px">Keep exploring</h2>
        <ul>{related.map((r) => <li><a class="textlink" href={url(r.href)}>{r.label}</a></li>)}</ul>
      </nav>
    )}
  </div>
</section>
<Cta />
