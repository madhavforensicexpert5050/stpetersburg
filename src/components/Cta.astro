---
import { url } from '../lib/url.ts';
import { isLive } from '../data/routes.ts';
import { business } from '../data/business.ts';
import CallButton from './CallButton.astro';
/**
 * Closing call to action. `label`, `href` and `note` are optional (V24, Portfolio); without them the band is
 * exactly as before: Request a Quote once that page is live, otherwise Contact Us, plus the bookings note.
 * `section` marks the band as a numbered main section (data-pf-section) on pages that count them.
 */
interface Props { h?: string; p?: string; label?: string; href?: string; note?: string; section?: string }
const { h = 'Have a property in mind?', p = 'Explore how virtual staging and careful image presentation can help communicate what a property offers.', label, href, note, section } = Astro.props;
---
<section class="cta-band" data-pf-section={section}>
  <div class="wrap">
    <div>
      <h2>{h}</h2>
      <p>{p}</p>
    </div>
    <div class="cta-band__actions">
      <div class="btn-row">
        <CallButton />
        {label && href ? <a class="btn" href={href}>{label}</a> : isLive('/request-quote/') ? <a class="btn" href={url('/request-quote/')}>Request a Quote</a> : <a class="btn" href={isLive('/contact/') ? url('/contact/') : business.emailHref}>Contact Us</a>}
      </div>
      {!isLive('/request-quote/') && <p class="cta-band__note">{note ?? 'Project bookings are not open yet. Questions are welcome.'}</p>}
    </div>
  </div>
</section>
