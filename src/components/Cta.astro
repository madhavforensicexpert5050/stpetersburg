---
import { url } from '../lib/url.ts';
import { isLive } from '../data/routes.ts';
import { business } from '../data/business.ts';
import CallButton from './CallButton.astro';
interface Props { h?: string; p?: string }
const { h = 'Have a property in mind?', p = 'Explore how virtual staging and careful image presentation can help communicate what a property offers.' } = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <div>
      <h2>{h}</h2>
      <p>{p}</p>
    </div>
    <div class="cta-band__actions">
      <div class="btn-row">
        <CallButton />
        {isLive('/request-quote/') ? <a class="btn" href={url('/request-quote/')}>Request a Quote</a> : <a class="btn" href={isLive('/contact/') ? url('/contact/') : business.emailHref}>Contact Us</a>}
      </div>
      {!isLive('/request-quote/') && <p class="cta-band__note">Project bookings are not open yet. Questions are welcome.</p>}
    </div>
  </div>
</section>
