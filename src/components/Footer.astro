---
import { url } from '../lib/url.ts';
import { business } from '../data/business.ts';
import { pagedServices as services } from '../data/services.ts';
import { legalDocs } from '../data/legal.ts';
import { isLive } from '../data/routes.ts';
import BrandLogo from './BrandLogo.astro';
const year = new Date().getFullYear();
// Only published pages: legal links appear automatically once a policy is approved and built.
// Owner decision (2026-11-13): no "About our images" link here. About #images stays, linked from the Portfolio.
const bottomLinks = legalDocs.filter((d) => isLive(d.path)).map((d) => [d.path, d.h1]);
const live = (xs: string[][]) => xs.filter(([p]) => isLive(p));
// Each page appears once per group. Pages dropped from the header (Guides, Contact) stay reachable here.
// The owner removed Who We Serve (V18.2) and Explore (V19); Portfolio is in the header.
const groups = [
  { h: 'Services', links: [...services.filter((s) => isLive(s.path)).map((s) => [s.path, s.name]), ...live([['/services/', 'All services']])] },
  { h: 'Company', links: live([['/about/', 'About StageLiora'], ['/about/devender-garg/', 'About Devender Garg'], ['/contact/', 'Contact'], ['/pricing/', 'Pricing'], ['/reviews/', 'Reviews']]) },
  { h: 'Resources', links: live([['/guides/', 'Guides'], ['/how-it-works/', 'How It Works'], ['/portfolio/', 'Portfolio'], ['/faq/', 'FAQ'], ['/locations/', 'Pinellas County city guides']]) },
].filter((g) => g.links.length > 0);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <BrandLogo variant="footer" />
        <p>{business.footerAbout}</p>
        <p><a href={business.emailHref}>{business.email}</a><br /><a href={business.phoneHref}>{business.phoneDisplay}</a></p>
      </div>
      {groups.map((g) => (
        <nav aria-label={`Footer: ${g.h}`}>
          <h2>{g.h}</h2>
          <ul>{g.links.map(([p, l]) => <li><a href={url(p)}>{l}</a></li>)}</ul>
        </nav>
      ))}
    </div>
  </div>
  <div class="foot-bar">
    <div class="wrap">
      <p>&copy; {year} {business.brand}. All rights reserved.</p>
      {(bottomLinks.length > 0) && <ul aria-label="Site information">{bottomLinks.map(([p, l]) => <li><a href={url(p)}>{l}</a></li>)}</ul>}
    </div>
  </div>
</footer>
