---
import { url } from '../lib/url.ts';
import PageHero from '../components/PageHero.astro';
import Notice from '../components/Notice.astro';
import { locations, decisionLabel } from '../data/locations.ts';
import { isLive, isInternalReview } from '../data/routes.ts';
---
<PageHero path="/locations/" eyebrow="Locations" h1="St. Petersburg area market notes" lede="Housing-mix notes for St. Petersburg and nearby Pinellas County cities, to help plan listing photos. StageLiora works remotely and has no office in any of them." />
<section class="section">
  <div class="wrap">
    <Notice h="Market notes, not service-area claims">A place listed here has market data only. Its inclusion is not a claim of a local office or a confirmed service area.{isInternalReview && <> Decisions below are recommendations for the owner.</>}</Notice>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Pinellas County places">
      <table>
        <caption>Census data: ACS 2020–2024 5-year estimates, table B25024. Building types, not ownership form.</caption>
        <thead><tr><th scope="col">Place</th><th scope="col">Relationship to St. Petersburg</th><th scope="col">Detached</th><th scope="col">10+ units</th><th scope="col">Mobile</th>{isInternalReview && <th scope="col">Decision</th>}</tr></thead>
        <tbody>
          {locations.map((l) => <tr><td>{isLive(l.path) ? <a href={url(l.path)}>{l.name}</a> : l.name}</td><td>{l.relationship}</td><td>{l.detached}%</td><td>{l.tenPlus}%</td><td>{l.mobile}%</td>{isInternalReview && <td>{decisionLabel[l.decision]}</td>}</tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>
