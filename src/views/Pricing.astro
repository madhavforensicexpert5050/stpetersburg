---
/**
 * Pricing: four cards (Pay As You Go, Essential Bundle, Plus Bundle, Dedicated Assistance).
 * Figures appear only from approvals.planPricing (see src/data/pricing-plans.ts). No reference-site prices.
 * Every button is an inquiry (Contact page or phone); there is no checkout.
 */
import { url } from '../lib/url.ts';
import Crumbs from '../components/Crumbs.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import CallButton from '../components/CallButton.astro';
import { pricing } from '../data/content.ts';
import { plans, approvedPrice, anyPlanPriced, usd } from '../data/pricing-plans.ts';
import { services, trackLabel } from '../data/services.ts';
import { business } from '../data/business.ts';
import { isLive } from '../data/routes.ts';
const contactHref = isLive('/contact/') ? url('/contact/') : business.emailHref;
const rows = pricing.rows.filter((r) => r.price !== null && isLive(services.find((s) => s.slug === r.slug)!.path));
const priced = anyPlanPriced();
---
<section class="pricing-hero">
  <div class="wrap">
    <Crumbs path="/pricing/" />
    <h1>Virtual Staging Pricing</h1>
    <p class="lede">Explore flexible pricing options for property image visualization, from individual images to larger photo requirements.</p>
  </div>
</section>

<section class="section section--tight pricing-plans">
  <div class="wrap">
    <h2 class="visually-hidden">Pricing options</h2>
    <ul class="plan-grid">
      {plans.map((p) => {
        const price = approvedPrice(p.planId);
        return (
          <li class:list={['plan', { 'plan--assist': p.variant === 'assist' }]}>
            <h3 class="plan__name">{p.planName}</h3>
            <p class="plan__sub">{p.subtitle}</p>
            <div class="plan__price">
              {price?.pricePerPhoto != null ? (
                <p class="plan__amount"><span>{usd(price.pricePerPhoto)}</span> <small>/ photo</small></p>
              ) : (
                <p class="plan__amount plan__amount--model">{p.model}</p>
              )}
              <p class="plan__note">{price?.prepaidAmount != null ? `Prepay ${usd(price.prepaidAmount)}${price.includedPhotos ? ` · ${price.includedPhotos} photos` : ''}` : p.modelNote}</p>
            </div>
            <ul class="plan__features">{p.features.map((f) => <li>{f}</li>)}</ul>
            <div class="plan__cta">
              {p.ctaDestination === 'tel'
                ? <><CallButton /><a class="plan__secondary" href={contactHref}>Contact Us</a></>
                : <a class="btn plan__btn" href={contactHref}>{p.ctaLabel}</a>}
            </div>
          </li>
        );
      })}
    </ul>
    <p class="plan-footnote">{priced ? 'Prices are per finished image for the virtual staging service. The exact cost for your photos is confirmed before any work begins.' : 'Rates are not listed on the site yet. Ask about pricing for your listing by phone or through the Contact page. Nothing can be purchased online.'}</p>
  </div>
</section>

{rows.length > 0 && <section class="section section--tight">
  <div class="wrap">
    <div class="table-wrap" tabindex="0" role="region" aria-label="Pricing by service">
      <table>
        <caption>Per-image rates by service</caption>
        <thead><tr><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Price per image</th></tr></thead>
        <tbody>{rows.map((r) => <tr><td>{r.name}</td><td>{trackLabel[r.track]}</td><td>{usd(r.price!)}</td></tr>)}</tbody>
      </table>
    </div>
  </div>
</section>}

<section class="section section--wall">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Cost factors</p><h2>What affects virtual staging pricing?</h2></div>
      <p class="lede">Two photos that look alike can need very different amounts of work. These are the things that decide it.</p>
    </div>
    <div class="grid grid--3">
      {pricing.factors.map((f) => <div class="card card--flat"><h3>{f.h}</h3><p>{f.b}</p></div>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Before you start</p><h2>Know what goes into your project</h2></div>
    <div class="grid grid--4 expect">
      {pricing.expect.map((x) => (
        <div class="card">
          <h3>{x.h}</h3>
          <p>{x.b}</p>
          {x.href && isLive(x.href) && <a class="textlink" href={url(x.href)}>{x.link}</a>}
        </div>
      ))}
    </div>
  </div>
</section>

<Cta h="Questions about the right option?" p="Discuss your property images, visual goals and the type of presentation you are considering." />

<section class="section">
  <div class="wrap two-col">
    <div><p class="eyebrow">Questions</p><h2>Pricing FAQ</h2>{isLive('/guides/virtual-staging-cost/') && <p style="margin-top:14px"><a class="textlink" href={url('/guides/virtual-staging-cost/')}>What virtual staging costs across the market</a></p>}</div>
    <Faq items={pricing.faqs} />
  </div>
</section>
