---
import { url } from '../lib/url.ts';
import PageHero from '../components/PageHero.astro';
import MediaImage from '../components/MediaImage.astro';
import Cta from '../components/Cta.astro';
import { guides, featuredOf } from '../data/guides.ts';
import { getPair } from '../data/media.ts';
import { isLive } from '../data/routes.ts';
// Featured images are decorative here: the card's heading names the guide, so the images carry empty alt text.
const SIZES = '(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 420px';
const cards = guides.filter((g) => isLive(g.path)).map((g) => {
  const f = featuredOf(g);
  return { g, f, p: f ? getPair(f.pair) : null };
});
---
<PageHero path="/guides/" eyebrow="Guides" h1="Plain guides to virtual staging" lede="What it is, what it costs, how to shoot for it, and how to disclose it in Florida. Sources are listed in each guide." />
<section class="section">
  <div class="wrap grid grid--3">
    {cards.map(({ g, f, p }) => (
      <a class="card card--link gcard" href={url(g.path)}>
        {f && p && (
          <div class:list={['gcard__img', { 'gcard__img--split': f.show === 'split' }]} aria-hidden="true">
            <MediaImage media={p.before} alt="" sizes={SIZES} />
            {f.show === 'split' && <MediaImage media={p.after} alt="" sizes={SIZES} class="gcard__after" />}
            {f.show === 'split' && <><span class="gcard__tag gcard__tag--b">Before</span><span class="gcard__tag gcard__tag--a">After</span></>}
            {f.show === 'before' && <span class="gcard__tag gcard__tag--b">Original photo</span>}
          </div>
        )}
        <h2 style="font-size:1.35rem">{g.h1}</h2>
        <p>{g.summary}</p>
        <span class="gal__meta gcard__meta">{g.reading} read</span>
      </a>
    ))}
  </div>
</section>
<Cta />

<style>
  .gcard { overflow: hidden; }
  .gcard__img { position: relative; aspect-ratio: 3 / 2; margin: calc(-1 * clamp(20px, 2.2vw, 30px)) calc(-1 * clamp(20px, 2.2vw, 30px)) 8px; background: var(--wall); overflow: hidden; }
  .gcard__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gcard__img :global(.gcard__after) { clip-path: inset(0 0 0 50%); }
  .gcard__img--split::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--sun); }
  .gcard__tag { position: absolute; top: 10px; padding: 3px 8px; border-radius: 4px; font: 650 .72rem/1.2 var(--text); letter-spacing: .02em; }
  .gcard__tag--b { left: 10px; background: var(--ink); color: #fff; }
  .gcard__tag--a { right: 10px; background: var(--sun); color: var(--ink); }
  .gcard__meta { margin-top: auto; }
  .gcard__img :global(img) { transition: transform .3s ease; }
  .gcard:hover .gcard__img :global(img) { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) { .gcard__img :global(img) { transition: none; } .gcard:hover .gcard__img :global(img) { transform: none; } }
</style>
