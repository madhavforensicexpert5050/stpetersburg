---
import PageHero from '../components/PageHero.astro';
import Compare from '../components/Compare.astro';
import Cta from '../components/Cta.astro';
import Notice from '../components/Notice.astro';
import { portfolioPairs, anyIllustrations } from '../data/media.ts';
import { rooms, styles } from '../data/taxonomy.ts';
---
<PageHero path="/portfolio/" eyebrow="Portfolio" h1="Before and after, room by room" lede="Drag the divider to compare each room. Furniture and decor change. Walls, windows, floors and fixtures stay as they are." />
<section class="section">
  <div class="wrap">
    {anyIllustrations() && <Notice h="AI-generated demonstrations">These comparisons show fictional properties created for demonstration. They are not photographs of real listings or completed StageLiora client projects. Licensed client work will be added and labeled when it is available.</Notice>}
    <div class="grid grid--2">
      {portfolioPairs.map((p) => (
        <article>
          <Compare pair={p.key} />
          <h2 style="font-size:1.25rem;margin-top:6px">{rooms.find((r) => r.id === p.room)!.name}</h2>
          <p class="gal__meta">{styles.find((s) => s.id === p.style)!.name} direction</p>
        </article>
      ))}
    </div>
  </div>
</section>
<Cta />
