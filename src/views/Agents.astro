---
/**
 * /for-real-estate-agents/ (V17). A decision page for listing agents: fit, rooms, vacant vs occupied, photo prep,
 * review, Stellar disclosure, cost and workflow. Copy lives in src/data/agents-page.ts.
 * Styles are scoped here so the shared stylesheet is untouched.
 */
import { url } from '../lib/url.ts';
import PageHero from '../components/PageHero.astro';
import CallButton from '../components/CallButton.astro';
import LinkButton from '../components/LinkButton.astro';
import Faq from '../components/Faq.astro';
import { agentsPage as a, agentSources, STELLAR_0404 } from '../data/agents-page.ts';
import { exampleCurrent } from '../data/image-notes.ts';
import { media } from '../data/media.ts';
import { isLive } from '../data/routes.ts';
import { business } from '../data/business.ts';

const PATH = '/for-real-estate-agents/';
const PAIR = 'showcase-bedroom';
// The example explanation describes these two files only. If either is replaced, the section is hidden (and npm run qa fails).
const showExample = exampleCurrent([`${PAIR}-before`, `${PAIR}-after`], media);
const live = (p: string) => isLive(p);
const contactHref = live('/contact/') ? url('/contact/') : business.emailHref;
---
<PageHero path={PATH} eyebrow={a.eyebrow} h1={a.h1} lede={a.lede} pair={PAIR}>
  <div class="agents-hero-cta">
    <CallButton />
    <a class="btn" href={contactHref}>Contact StageLiora</a>
  </div>
  <nav class="agents-toc" aria-label="On this page">
    <p class="agents-toc__label">On this page</p>
    <ul>{a.onThisPage.map((x) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}</ul>
  </nav>
</PageHero>

<!-- 1. Fit -->
<section class="section" id="fit" aria-labelledby="fit-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Start here</p>
      <h2 id="fit-h">{a.fit.h}</h2>
      <p class="lede">{a.fit.intro}</p>
    </div>
    <div class="agents-fit">
      <div class="agents-fit__col agents-fit__col--yes">
        <h3>Where it usually helps</h3>
        <ul class="tick agents-list">{a.fit.helps.map((x) => <li><strong>{x.h}.</strong> {x.b}</li>)}</ul>
      </div>
      <div class="agents-fit__col agents-fit__col--no">
        <h3>What it will not fix</h3>
        <ul class="cross agents-list">{a.fit.limits.map((x) => <li><strong>{x.h}.</strong> {x.b}</li>)}</ul>
      </div>
    </div>
    {live('/guides/virtual-staging-vs-traditional-staging/') && <p class="agents-more">Weighing a furnished showing instead? Read <a href={url('/guides/virtual-staging-vs-traditional-staging/')}>virtual staging compared with traditional staging</a>.</p>}
  </div>
</section>

<!-- 2. Rooms -->
<section class="section section--wall" id="rooms" aria-labelledby="rooms-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Room priority</p>
      <h2 id="rooms-h">{a.rooms.h}</h2>
      <p class="lede">{a.rooms.intro}</p>
    </div>
    <div class="table-wrap agents-table" role="region" aria-labelledby="rooms-cap" tabindex="0">
      <table>
        <caption id="rooms-cap">{a.rooms.table.caption}</caption>
        <thead><tr>{a.rooms.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{a.rooms.table.rows.map(([room, yes, no]) => <tr><th scope="row">{room}</th><td data-label={a.rooms.table.head[1]}>{yes}</td><td data-label={a.rooms.table.head[2]}>{no}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="agents-notes">
      <aside class="agents-note">
        <p class="agents-note__h">What the research says</p>
        <p>{a.rooms.nar}</p>
      </aside>
      <aside class="agents-note agents-note--plain">
        <p class="agents-note__h">Leave some rooms alone</p>
        <p>{a.rooms.skip}</p>
      </aside>
    </div>
    {(live('/portfolio/') || live('/design-styles/')) && (
      <div class="cta-row">
        {live('/portfolio/') && <LinkButton href="/portfolio/" label="See Room-by-Room Examples" />}
        {live('/design-styles/') && <LinkButton href="/design-styles/" label="Choose a Style for the Home" />}
      </div>
    )}
  </div>
</section>

<!-- 3. Vacant vs occupied -->
<section class="section" id="vacant-occupied" aria-labelledby="vo-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Vacant or occupied</p>
      <h2 id="vo-h">{a.vacantOccupied.h}</h2>
      <p class="lede">{a.vacantOccupied.intro}</p>
    </div>
    <div class="table-wrap agents-table agents-table--vo" role="region" aria-labelledby="vo-cap" tabindex="0">
      <table>
        <caption id="vo-cap">{a.vacantOccupied.table.caption}</caption>
        <thead><tr><td></td><th scope="col">Vacant home</th><th scope="col">Occupied home</th></tr></thead>
        <tbody>{a.vacantOccupied.table.rows.map(([k, v, o]) => <tr><th scope="row">{k}</th><td data-label="Vacant home">{v}</td><td data-label="Occupied home">{o}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="agents-prose">{a.vacantOccupied.note}</p>
    <div class="cta-row">
      {live('/services/virtual-staging/') && <LinkButton href="/services/virtual-staging/" label="Virtual Staging for Empty Rooms" />}
      {live('/services/furniture-removal-and-staging/') && <LinkButton href="/services/furniture-removal-and-staging/" label="Furniture Removal and Staging" />}
    </div>
  </div>
</section>

<!-- 4. Photos + 5. Review -->
<section class="section section--wall" id="photos" aria-labelledby="photos-h">
  <div class="wrap two-col agents-split">
    <div>
      <p class="eyebrow">Before you send anything</p>
      <h2 id="photos-h">{a.photos.h}</h2>
      <p class="lede">{a.photos.intro}</p>
      {live('/guides/how-to-prepare-photos-for-virtual-staging/') && <div class="cta-row"><LinkButton href="/guides/how-to-prepare-photos-for-virtual-staging/" label="Full Photo Preparation Guide" icon="camera" /></div>}
    </div>
    <ul class="tick agents-checklist">{a.photos.items.map((x) => <li>{x}</li>)}</ul>
  </div>
</section>

<section class="section" id="review" aria-labelledby="review-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Quality check</p>
      <h2 id="review-h">{a.review.h}</h2>
      <p class="lede">{a.review.intro}</p>
    </div>
    <div class="grid grid--4 agents-checks">
      {a.review.checks.map((c) => <div class="agents-check"><h3>{c.h}</h3><p>{c.b}</p></div>)}
    </div>
    <p class="agents-stop"><strong>Stop rule:</strong> {a.review.close}</p>

    {showExample && (
      <section class="agents-example" aria-labelledby="ex-h">
        <h3 id="ex-h">{a.example.h}</h3>
        <p>{a.example.intro}</p>
        <dl>{a.example.rows.map((r) => <div><dt>{r.h}</dt><dd>{r.b}</dd></div>)}</dl>
        {live('/portfolio/') && <p class="agents-more">More comparisons, room by room, are in the <a href={url('/portfolio/')}>before-and-after portfolio</a>.</p>}
      </section>
    )}
  </div>
</section>

<!-- 6. MLS -->
<section class="section on-ink" id="mls" aria-labelledby="mls-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Stellar MLS</p>
      <h2 id="mls-h">{a.mls.h}</h2>
      <p class="lede">{a.mls.intro}</p>
    </div>
    <div class="agents-mls">
      <div class="agents-mls__steps">
        <h3>The three required disclosure steps</h3>
        <ol>{a.mls.steps.map((s) => <li>{s}</li>)}</ol>
        <p class="agents-mls__penalty">{a.mls.penalty}</p>
      </div>
      <div class="agents-mls__rules">
        <h3>What the edit itself must not do</h3>
        <dl>{a.mls.rules.map((r) => <div><dt>{r.h}</dt><dd>{r.b}</dd></div>)}</dl>
      </div>
    </div>
    <p class="agents-mls__resp">{a.mls.responsibility}</p>
    <div class="cta-row">
      <a class="btn btn--cta btn--primary" href={STELLAR_0404} rel="noopener nofollow">
        <span>Read Stellar Article 04.04</span>
        <svg class="btn__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
      </a>
      {live('/guides/virtual-staging-disclosure-florida/') && <LinkButton href="/guides/virtual-staging-disclosure-florida/" label="Florida Disclosure Guide" icon="guide" />}
    </div>
  </div>
</section>

<!-- 7. Cost -->
<section class="section" id="cost" aria-labelledby="cost-h">
  <div class="wrap two-col agents-split">
    <div>
      <p class="eyebrow">Budget</p>
      <h2 id="cost-h">{a.cost.h}</h2>
      <p class="lede">{a.cost.intro}</p>
      <p class="agents-rates">{a.cost.rates}</p>
      {a.cost.example && <p class="agents-prose">{a.cost.example}</p>}
      <div class="cta-row">
        {live('/pricing/') && <LinkButton href="/pricing/" label="View Pricing" variant="primary" />}
        {live('/guides/virtual-staging-cost/') && <LinkButton href="/guides/virtual-staging-cost/" label="How Market Prices Compare" icon="guide" />}
      </div>
    </div>
    <div class="agents-factors">
      {a.cost.factors.map((f) => <div><h3>{f.h}</h3><p>{f.b}</p></div>)}
    </div>
  </div>
</section>

<!-- 8. Workflow -->
<section class="section section--wall" id="workflow" aria-labelledby="wf-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Step by step</p>
      <h2 id="wf-h">{a.workflow.h}</h2>
      <p class="lede">{a.workflow.intro}</p>
    </div>
    <ol class="steps">
      {a.workflow.steps.map((s, i) => (
        <li><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{s.h}</h3><p>{s.b}</p></div></li>
      ))}
    </ol>
    <div class="cta-row">
      {live('/how-it-works/') && <LinkButton href="/how-it-works/" label="How StageLiora Works" />}
      {live('/guides/virtual-staging-for-real-estate-agents/') && <LinkButton href="/guides/virtual-staging-for-real-estate-agents/" label="Talking to Sellers and Preparing Showings" icon="guide" />}
    </div>
  </div>
</section>

<!-- 9. FAQ -->
<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap agents-faq">
    <div>
      <p class="eyebrow">Agent questions</p>
      <h2 id="faq-h">Questions listing agents ask</h2>
      {live('/faq/') && <p class="agents-more">General questions about the service are on the <a href={url('/faq/')}>main FAQ page</a>.</p>}
    </div>
    <Faq items={a.faqs} />
  </div>
  <div class="wrap">
    <div class="sources agents-sources">
      <h2>Sources checked November 10, 2026</h2>
      <ul>{agentSources.map((s) => <li><a href={s.url} rel="noopener nofollow">{s.name}</a></li>)}</ul>
    </div>
  </div>
</section>

<!-- 10. Next step -->
<section class="cta-band" aria-labelledby="next-h">
  <div class="wrap">
    <div>
      <h2 id="next-h">{a.cta.h}</h2>
      <p>{a.cta.p}</p>
    </div>
    <div class="cta-band__actions">
      <div class="btn-row">
        <CallButton />
        <a class="btn" href={contactHref}>Contact StageLiora</a>
        {live('/pricing/') && <a class="btn" href={url('/pricing/')}>View Pricing</a>}
      </div>
      <p class="cta-band__note">Project bookings are not open yet. Questions are welcome at <a href={business.emailHref}>{business.email}</a>.</p>
    </div>
  </div>
</section>

<style>
  .agents-hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .agents-toc { margin-top: 26px; }
  .agents-toc__label { font: 600 .74rem/1.2 var(--text); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .agents-toc ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .agents-toc li { margin: 0; }
  .agents-toc a { display: inline-flex; align-items: center; min-height: 36px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink); font-size: .9rem; text-decoration: none; }
  .agents-toc a:hover { border-color: var(--ink); }
  .agents-toc a:focus-visible { outline: 3px solid var(--sun-deep); outline-offset: 2px; }

  .agents-fit { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: clamp(16px, 2.4vw, 32px); }
  .agents-fit__col { padding: clamp(20px, 2.4vw, 32px); border-radius: 6px; border: 1px solid var(--line); background: #fff; min-width: 0; }
  .agents-fit__col--yes { border-top: 4px solid var(--ok); }
  .agents-fit__col--no { border-top: 4px solid var(--err); background: #fffaf5; }
  .agents-fit__col h3 { font-size: 1.25rem; margin: 0 0 14px; }
  .agents-list li { margin-bottom: 12px; }
  .agents-list li:last-child { margin-bottom: 0; }
  .agents-list strong { color: var(--ink); }
  .agents-more { margin: 22px 0 0; max-width: 72ch; }

  .agents-table { background: #fff; border: 1px solid var(--line); border-radius: 6px; }
  .agents-table:focus-visible { outline: 3px solid var(--sun-deep); outline-offset: 2px; }
  .agents-table table { min-width: 640px; }
  .agents-table caption { padding: 14px 14px 8px; }
  .agents-table tbody th { white-space: nowrap; color: var(--ink); }
  .agents-table tbody tr:last-child > * { border-bottom: 0; }
  .agents-table--vo thead th:nth-child(2) { border-bottom: 3px solid var(--sun); }
  .agents-table--vo thead th:nth-child(3) { border-bottom: 3px solid var(--ink); }
  /* Phones: each row becomes a labeled card instead of a sideways-scrolling table. */
  @media (max-width: 640px) {
    .agents-table { overflow: visible; background: transparent; border: 0; }
    .agents-table table { min-width: 0; }
    .agents-table caption { display: block; width: 100%; padding: 0 0 10px; }
    .agents-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .agents-table table, .agents-table tbody, .agents-table tr, .agents-table th, .agents-table td { display: block; width: 100%; }
    .agents-table tr { background: #fff; border: 1px solid var(--line); border-radius: 6px; margin-bottom: 12px; padding: 4px 0; }
    .agents-table tbody th { white-space: normal; background: transparent; font-size: 1.05rem; border-bottom: 1px solid var(--line); }
    .agents-table td { border-bottom: 0; padding-top: 8px; padding-bottom: 8px; }
    .agents-table td::before { content: attr(data-label); display: block; font: 600 .74rem/1.3 var(--text); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 3px; }
  }

  .agents-notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 16px; margin-top: 22px; }
  .agents-note { background: #fbf7ee; border: 1px solid #efe4c9; border-left: 3px solid var(--sun); border-radius: 6px; padding: 18px 20px; }
  .agents-note--plain { background: #fff; border-color: var(--line); border-left-color: var(--ink); }
  .agents-note p { margin: 0; }
  .agents-note__h { font-weight: 650; color: var(--ink); margin-bottom: 6px !important; }
  .agents-prose { max-width: 72ch; margin: 22px 0 0; }

  .agents-split { align-items: start; }
  .agents-checklist { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 6px; padding: clamp(20px, 2.4vw, 30px) clamp(20px, 2.4vw, 30px) clamp(20px, 2.4vw, 30px) clamp(20px, 2.4vw, 30px); }
  .agents-checklist li { margin-bottom: 12px; }
  .agents-checklist li:last-child { margin-bottom: 0; }

  .agents-checks { grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); }
  .agents-check { background: var(--wall); border-radius: 6px; padding: 20px; border-top: 3px solid var(--bay); min-width: 0; }
  .agents-check h3 { font-size: 1.1rem; margin: 0 0 6px; }
  .agents-check p { margin: 0; }
  .agents-stop { margin: 22px 0 0; padding: 14px 18px; border-left: 3px solid var(--err); background: #fffaf5; max-width: 72ch; }

  .agents-example { margin-top: clamp(32px, 4vw, 52px); padding: clamp(20px, 2.6vw, 34px); border: 2px solid var(--ink); border-radius: 6px; }
  .agents-example h3 { margin: 0 0 6px; }
  .agents-example > p { margin: 0 0 14px; max-width: 72ch; }
  .agents-example dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 16px 28px; margin: 0; }
  .agents-example dt { font-weight: 650; color: var(--ink); margin-bottom: 4px; }
  .agents-example dd { margin: 0; }

  .agents-mls { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(20px, 3vw, 44px); align-items: start; }
  @media (max-width: 900px) { .agents-mls { grid-template-columns: minmax(0, 1fr); } }
  .agents-mls h3 { font-size: 1.2rem; margin: 0 0 14px; }
  .agents-mls__steps { background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 197, 61, .5); border-radius: 6px; padding: clamp(20px, 2.4vw, 30px); }
  .agents-mls__steps ol { margin: 0; padding-left: 1.3em; color: var(--on-ink); }
  .agents-mls__steps li { margin-bottom: 10px; }
  .agents-mls__penalty { margin: 16px 0 0; font-size: .95rem; }
  .agents-mls__rules dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 18px 28px; margin: 0; }
  .agents-mls__rules dt { color: #fff; font-weight: 650; margin-bottom: 4px; }
  .agents-mls__rules dd { margin: 0; }
  .agents-mls__resp { margin: 28px 0 0; max-width: 78ch; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .18); color: var(--on-ink); }

  .agents-rates { margin: 18px 0 0; padding: 16px 18px; background: #fbf7ee; border: 1px solid #efe4c9; border-left: 3px solid var(--sun); border-radius: 6px; color: var(--ink); max-width: 62ch; }
  .agents-factors { display: grid; gap: 0; }
  .agents-factors > div { padding: 18px 0; border-top: 1px solid var(--line); }
  .agents-factors > div:first-child { border-top: 3px solid var(--ink); }
  .agents-factors h3 { font-size: 1.15rem; margin: 0 0 6px; }
  .agents-factors p { margin: 0; }

  /* The shared gold numerals lack contrast on the gray section background; a deeper gold keeps the accent. */
  .steps .n { color: #8a5c00; }
  .cta-band__note a { color: var(--sun); overflow-wrap: anywhere; }

  .agents-faq { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(20px, 4vw, 64px); align-items: start; }
  @media (max-width: 900px) { .agents-faq { grid-template-columns: minmax(0, 1fr); } }
  .agents-sources { margin-top: clamp(36px, 4vw, 56px); }
  .agents-sources li { margin-bottom: 6px; overflow-wrap: anywhere; }
</style>
