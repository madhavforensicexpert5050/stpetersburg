---
import { url } from '../lib/url.ts';
import { services } from '../data/services.ts';
import { isLive } from '../data/routes.ts';
const { path } = Astro.props;
const listing = services.filter((s) => s.track === 'listing-editing' && isLive(s.path));
const concept = services.filter((s) => s.track === 'concept-visualization' && isLive(s.path));
const primary = [
  { href: '/how-it-works/', label: 'How It Works' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/design-library/', label: 'Design Library' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/guides/', label: 'Guides' },
  { href: '/contact/', label: 'Contact' },
].filter((x) => isLive(x.href));
const who = [
  { href: '/for-real-estate-agents/', label: 'Real estate agents' },
  { href: '/for-real-estate-photographers/', label: 'Photographers' },
  { href: '/for-brokerages/', label: 'Brokerages' },
].filter((x) => isLive(x.href));
---
<header class="site-header">
  <div class="wrap head-in">
    <a class="logo" href={url(isLive('/') ? '/' : '#main')} aria-label="StageLiora home">Stage<i aria-hidden="true"></i>Liora</a>
    <nav class="nav" id="site-nav" aria-label="Main">
      {(listing.length + concept.length > 0 || isLive('/services/')) && (
        <details data-nav-menu>
          <summary>Services</summary>
          <div class="mega">
            <div>
              <h3>Listing photo edits</h3>
              {listing.map((s) => <a href={url(s.path)}>{s.name}</a>)}
            </div>
            <div>
              <h3>Concept visualizations</h3>
              {concept.map((s) => <a href={url(s.path)}>{s.name}</a>)}
              {isLive('/services/') && <a href={url('/services/')}><strong>All services</strong></a>}
            </div>
          </div>
        </details>
      )}
      {who.length > 0 && (
        <details data-nav-menu>
          <summary>Who It's For</summary>
          <div class="mega" style="width:min(300px,80vw);grid-template-columns:1fr">
            {who.map((x) => <a href={url(x.href)}>{x.label}</a>)}
          </div>
        </details>
      )}
      {primary.map((x) => <a href={url(x.href)} aria-current={path === x.href ? 'page' : undefined}>{x.label}</a>)}
    </nav>
    <div class="head-cta">
      {isLive('/request-quote/') && <a class="btn btn--primary" href={url('/request-quote/')}>Request a Quote</a>}
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>Menu</button>
    </div>
  </div>
</header>
