---
import { url } from '../lib/url.ts';
import MediaImage from '../components/MediaImage.astro';
import Compare from '../components/Compare.astro';
import CallButton from '../components/CallButton.astro';
import LinkButton from '../components/LinkButton.astro';
import { founder } from '../data/founder.ts';
import { approvals } from '../data/approvals.ts';
import { anyPlanPriced, rateText } from '../data/pricing-plans.ts';
import ShowcaseTabs, { type ShowcaseItem } from '../components/ShowcaseTabs.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Lightbox from '../components/Lightbox.astro';
import { process, generalFaqs } from '../data/content.ts';
import { styles, rooms } from '../data/taxonomy.ts';
import { library, getMedia, isIllustration, zoomTitle, zoomLabel } from '../data/media.ts';
import { isLive } from '../data/routes.ts';
import { services } from '../data/services.ts';
const styleCards = styles.filter((s) => s.hasPage).map((s) => ({ s, img: getMedia(`lib-${s.id}-living-room`) }));
const roomCards = ['primary-bedroom', 'dining-room', 'home-office', 'sunroom', 'kitchen', 'patio'].map((id) => {
  const it = library.find((l) => l.room === id)!;
  return { name: rooms.find((r) => r.id === id)!.name, it };
});
const allFaqs = generalFaqs.flatMap((g) => g.items);
const faq = (q: string) => allFaqs.find((x) => x.q === q)!;
const faqs = [
  faq('What is virtual staging?'),
  faq('Do the walls, windows and floors stay the same?'),
  faq('Can I see the same room in more than one style?'),
  faq('Will an edited photo be compliant with my MLS?'),
  faq('Can the words "virtually staged" go on the image itself?'),
  faq('How is the price of a project set?'),
  faq('Will virtual staging guarantee a faster sale?'),
];
// NAR news release where the room-importance figures are published (checked 2026-11-10).
const NAR_STAGING = 'https://www.nar.realtor/newsroom/nar-report-reveals-home-staging-boosts-sale-prices-and-reduces-time-on-market';

// Room-by-room showcase: one tab per room, each a same-scene pair from the portfolio set.
const roomItems: ShowcaseItem[] = [
  { id: 'living', label: 'Living room', pair: 'pf-living-room', title: 'Living room', body: 'Seating, a rug and a few accessories show how much furniture the floor holds and where the walkway stays clear. It is usually the first room buyers look at.' },
  { id: 'primary', label: 'Primary bedroom', pair: 'pf-primary-bedroom', title: 'Primary bedroom', body: 'A bed with nightstands answers the question an empty bedroom raises: does a full set fit, with room to move around it?' },
  { id: 'guest', label: 'Guest bedroom', pair: 'pf-guest-bedroom', title: 'Guest bedroom', body: 'Small, empty bedrooms are easy to misread as storage. A furnished view shows the room working as a bedroom.' },
  { id: 'dining', label: 'Dining room', pair: 'pf-dining-room', title: 'Dining room', body: 'A table and chairs at true scale show how many people the room seats and how it connects to the kitchen.' },
  { id: 'office', label: 'Home office', pair: 'pf-home-office', title: 'Home office', body: 'A desk, chair and storage show how a spare room can work as an office, without suggesting it is anything other than a spare room.' },
  { id: 'kitchen', label: 'Kitchen and dining', pair: 'pf-kitchen', title: 'Open kitchen and dining', body: 'In an open plan, a dining set marks where the kitchen ends and the eating area begins. Cabinets, counters and appliances stay as photographed.' },
];

// Service demonstrations: every live service, with its Stellar MLS listing-use note up front.
const tone = { 'permitted-with-disclosure': 'ok', conditional: 'warn', 'not-for-listing-photos': 'no', 'not-addressed': 'no' } as const;
const serviceItems: ShowcaseItem[] = services.filter((s) => isLive(s.path)).map((s) => ({
  id: s.slug, label: s.name, pair: s.pairKey, title: s.name, body: s.short, href: s.path, linkLabel: `About ${s.name.toLowerCase()}`,
  pill: { text: `Stellar MLS: ${s.stellar.label}`, tone: tone[s.stellar.use] },
}));
// V19: styles and room designs live on the Portfolio (formerly /design-styles/ and /design-library/).
const lib = isLive('/portfolio/');
const liveServices = services.filter((s) => isLive(s.path));
const bothTracks = liveServices.some((s) => s.track === 'concept-visualization') && liveServices.some((s) => s.track === 'listing-editing');
const showStyles = lib;
const showRooms = lib;
const ico = (d: string) => `<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
// One icon per step of the approved four-step workflow (content.ts process): request, project, editing, delivery.
const stepIcons = [
  ico('<path d="M4 5h16v10H9l-5 4z"/><path d="M8 9h8M8 12h5"/>'),
  ico('<circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/>'),
  ico('<rect x="3" y="6" width="18" height="13" rx="1.5"/><circle cx="12" cy="12.5" r="3.2"/><path d="M8 6l1.5-2h5L16 6"/>'),
  ico('<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 8l1.5 1.5L14 6M9 13h6M9 17h6"/>'),
];
---
<section class="hero on-ink">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" style="margin:0">St. Petersburg, Florida</p>
      <h1>Virtual Staging for Real Estate Listings in <em>St. Petersburg, FL</em></h1>
      <p>Realistic virtual staging that helps buyers picture how each room lives, while the walls, windows, floors and fixtures stay exactly as photographed.</p>
      <div class="hero__cta">
        <CallButton />
        {isLive('/request-quote/') && <a class="btn" href={url('/request-quote/')}>Request a Quote</a>}
      </div>
    </div>
    <div class="hero__art"><Compare pair="hero-living" eager animate /></div>
  </div>
</section>

<section class="strip-facts" aria-label="What every example shows">
  <ul class="wrap">
    <li><svg class="ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M12 5v14"/><path d="M6.5 15.5l2-2.5 1.5 1.5M14.5 15.5h4"/></svg><div><b>Same-room comparisons</b><span>See the change while the original room layout stays in view.</span></div></li>
    <li><svg class="ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17v-5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5"/><path d="M3 17h18M6 17v2M18 17v2"/><path d="M7 10V8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg><div><b>Realistic furniture placement</b><span>Furnishings sized to believable room proportions.</span></div></li>
    <li><svg class="ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><rect x="9.5" y="13" width="5" height="7"/></svg><div><b>Property features preserved</b><span>Staging examples keep the fixed architecture as photographed.</span></div></li>
    <li><svg class="ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><circle cx="12" cy="16" r="3"/></svg><div><b>Multiple design styles</b><span>Eight interior directions to compare for one property.</span></div></li>
  </ul>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Before &amp; after</p><h2>A room is easier to judge with something in it</h2></div>
      <p class="lede">An empty room gives a buyer no sense of scale. Furniture answers simple questions: does a bed fit here, and what is this space for? Pick a room, then drag the divider.</p>
    </div>
    <ShowcaseTabs id="rooms" label="Rooms" items={roomItems} />
    <p class="small home-research">Where buyers look first: in NAR's <a href={NAR_STAGING} rel="noopener nofollow">2025 Profile of Home Staging</a> (agents surveyed February 2025, released May 6, 2025), the living room (37%), primary bedroom (34%) and kitchen (23%) were rated the most important rooms to stage for buyers. The survey covers staging in general, not virtual staging results.</p>
    {isLive('/portfolio/') && <div class="cta-row"><LinkButton href="/portfolio/" label="See Every Room in the Portfolio" /></div>}
  </div>
</section>

<section class="section section--wall">
  <div class="wrap">
    <div class="section-head section-head--split">
      {bothTracks
        ? <div><p class="eyebrow">Services</p><h2>Two kinds of work. We keep them apart.</h2></div>
        : <div><p class="eyebrow">Services</p><h2>Edits that show the property as it is</h2></div>}
      {bothTracks
        ? <p class="lede">Listing photo edits are meant to show a property as it really is. Concept visualizations show what could be, and they are for planning, not for an MLS listing photo.</p>
        : <p class="lede">Listing photo edits are meant to show a real property clearly, with limits that protect you and the buyer.</p>}
    </div>
    <ShowcaseTabs id="services" label="Services" items={serviceItems} />
    {isLive('/services/') && <div class="cta-row"><LinkButton href="/services/" label="Compare All Services and MLS Notes" /></div>}
  </div>
</section>

<section class="section on-ink process">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">How it works</p><h2>How virtual staging works</h2></div>
      <p class="lede">Four steps from your first message to the delivered images, with one person, Devender Garg, handling the project throughout.</p>
    </div>
    <ol class="process__list">
      {process.map((s, i) => (
        <li class="process__step">
          <div class="process__top"><span class="process__n">{s.n}</span><span class="process__icon" set:html={stepIcons[i]} /></div>
          <h3>{s.h}</h3>
          <p>{s.b}</p>
        </li>
      ))}
    </ol>
    <div class="cta-row cta-row--center">
      {isLive('/how-it-works/') && <LinkButton href="/how-it-works/" label="Explore the Full Process" variant="primary" icon="arrow" />}
      {isLive('/guides/how-to-prepare-photos-for-virtual-staging/') && <LinkButton href="/guides/how-to-prepare-photos-for-virtual-staging/" label="Photo Preparation Guide" icon="camera" />}
      {isLive('/contact/') && <LinkButton href="/contact/" label="Contact StageLiora" icon="contact" />}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">For listing agents</p><h2>Vacant or occupied, the edit is different</h2></div>
      <p class="lede">An empty home needs furniture to show what each room holds. A lived-in home needs the seller's belongings out of the way first.</p>
    </div>
    <div class="grid grid--2 home-vo">
      <div class="card home-vo__card">
        <Compare pair="svc-virtual-staging" />
        <h3>Vacant properties</h3>
        <p>Furniture and decor are placed in each empty room at true scale, so buyers can judge its size and purpose. Walls, floors and fixtures stay as photographed.</p>
        {isLive('/services/') && <LinkButton href="/services/#virtual-staging" label="Virtual Staging" />}
      </div>
      <div class="card home-vo__card">
        <Compare pair="svc-furniture-removal" />
        <h3>Occupied properties</h3>
        <p>Movable furniture and clutter are removed from the photo, then the room is restaged. Built-ins and anything that conveys with the house stay where they are.</p>
        {isLive('/services/furniture-removal-and-staging/') && <LinkButton href="/services/furniture-removal-and-staging/" label="Furniture Removal and Staging" />}
      </div>
    </div>
    {isLive('/guides/virtual-staging-for-real-estate-agents/') && <p class="home-vo__more">Planning a whole listing? <a class="textlink" href={url('/guides/virtual-staging-for-real-estate-agents/')}>How to use virtual staging for a real estate listing</a></p>}
  </div>
</section>

<section class="section section--wall">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Why virtual staging</p><h2>When it is worth it, and when it is not</h2></div>
      <p class="lede">Virtual staging changes how a room is read. It does not change the room. Knowing the difference keeps a listing honest and saves money on images that will not help.</p>
    </div>
    <div class="grid grid--2">
      <div class="card">
        <h3>A good fit</h3>
        <ul class="tick">
          <li>Rooms with no clear purpose, such as a loft, bonus room or alcove</li>
          <li>Spaces whose scale is hard to judge in a photo</li>
          <li>Vacant rooms that need furniture to show how they can be used</li>
          <li>Listings where dated furniture or an odd layout hides how the space works</li>
        </ul>
      </div>
      <div class="card">
        <h3>Not a fix for</h3>
        <ul class="cross">
          <li>An unrealistic asking price</li>
          <li>Poor condition or unfinished repairs, and damage must never be edited out</li>
          <li>Weak photography: a dark, blurred or tightly cropped photo needs a reshoot first</li>
          <li>Pre-construction listings, where Stellar MLS does not allow staging</li>
        </ul>
      </div>
    </div>
    <div class="cta-row">
      {isLive('/guides/what-is-virtual-staging/') && <LinkButton href="/guides/what-is-virtual-staging/" label="What Virtual Staging Is" icon="guide" />}
      {isLive('/guides/virtual-staging-vs-traditional-staging/') && <LinkButton href="/guides/virtual-staging-vs-traditional-staging/" label="Virtual or Traditional Staging?" icon="guide" />}
    </div>
  </div>
</section>

{showStyles && <section class="section section--tight section--wall">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Design inspiration</p><h2>Match the style to the house in the photo</h2></div>
      <p>Choose a direction that suits the architecture and the likely buyer.</p>
    </div>
  </div>
  <div class="strip" tabindex="0" role="region" aria-label="Design style previews">
    {styleCards.map(({ s, img }) => (
      <a href={url(`/portfolio/?style=${s.id}#room-designs`)}><MediaImage media={img} /><span>{s.name}</span></a>
    ))}
  </div>
</section>}

{showRooms && <section class="section">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Explore room transformations</p><h2>Rooms in each design direction</h2></div>
      <p>The same room types in different design directions. Compare how a style changes the feel of a space.</p>
    </div>
    <div class="gal">
      {roomCards.map(({ name, it }) => (
        <figure class="gal__item">
          <button type="button" class="gal__btn" data-zoom={url(it.src)} data-alt={it.alt} data-title={zoomTitle(it, name)} data-info={isIllustration(it) ? '' : it.caption} aria-label={zoomLabel(it, name)}>
            <MediaImage media={it} />
          </button>
          <figcaption><h3>{name}</h3><p class="gal__meta">{`${it.styleName} direction`}</p></figcaption>
        </figure>
      ))}
    </div>
    <div class="btn-row" style="margin-top:26px">
      {isLive('/portfolio/') && <a class="btn" href={url('/portfolio/')}>View Before and After Examples</a>}
      {lib && <a class="btn" href={url('/portfolio/#room-designs')}>Browse Room Designs by Style</a>}
    </div>
  </div>
</section>}

<section class="section on-ink">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Why StageLiora</p><h2>Standards behind every image</h2></div>
      <p class="lede">We would rather show you how we work than ask you to trust ratings we do not have.</p>
    </div>
    <div class="grid grid--4 standards">
      <div><h3>The room stays the room</h3><p>A listing edit adds or replaces movable furniture and decor. Walls, windows, floors, fixtures and views stay as photographed.</p></div>
      <div><h3>Every edit type is named</h3><p>Listing photo edits and concept visualizations are kept apart, and each service page says which one it is.</p></div>
      <div><h3>Disclosure is part of the job</h3><p>Each service carries its Stellar MLS note, and the original photo stays beside every edited one.</p></div>
      <div><h3>No borrowed proof</h3><p>No invented reviews, ratings or client work. How our example images are made is explained openly on the About page.</p></div>
    </div>
  </div>
</section>

{isLive(founder.path) && <section class="section founder-home">
  <div class="wrap founder-home__in">
    {approvals.founderPortrait
      ? <img class="founder-headshot" src={url(founder.portrait.headshot)} srcset={`${url(founder.portrait.headshotSmall)} 200w, ${url(founder.portrait.headshot)} 400w`} sizes="132px" width="400" height="400" alt={founder.portrait.altHeadshot} loading="lazy" decoding="async" />
      : <div class="founder-mark founder-mark--sm" aria-hidden="true"><span>DG</span></div>}
    <div>
      <p class="eyebrow">{founder.home.eyebrow}</p>
      <h2>{founder.home.h}</h2>
      <p class="lede">{founder.home.p}</p>
      <div class="cta-row"><LinkButton href={founder.path} label="Read My Story" variant="primary" /></div>
    </div>
  </div>
</section>}

<section class="section section--wall">
  <div class="wrap two-col">
    <div>
      <p class="eyebrow">Pricing</p>
      <h2>Priced before any work begins</h2>
      <p class="lede" style="margin-top:16px">{anyPlanPriced() && rateText('pay-as-you-go') ? `Pay As You Go is ${rateText('pay-as-you-go')}, with lower per-photo rates for bundled sets. Cost depends on the service, the number of images and what each room needs, and any project is priced before work begins.` : 'Cost depends on the service, the number of images and what each room needs. Rates are not published on the site, so ask about your listing directly. Any project is priced before work begins.'}</p>
      {isLive('/pricing/') && <div class="cta-row"><LinkButton href="/pricing/" label="See Pricing" /></div>}
    </div>
    <div class="mls">
      <h3>Image accuracy and disclosure</h3>
      <p>Stellar MLS Article 04.04 requires "Virtually staged" in the photo description, the virtually staged field checked, and public remarks that begin "One or more photo(s) was virtually staged."</p>
      <p>It also strictly prohibits words on property photos, so the labels on this website are explanations and not MLS labels. We cannot promise compliance. The rules change, and the listing is yours.</p>
      {isLive('/guides/virtual-staging-disclosure-florida/') && <a class="textlink" href={url('/guides/virtual-staging-disclosure-florida/')}>Read the Florida disclosure guide</a>}
    </div>
  </div>
</section>

<section class="section on-ink">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">St. Petersburg property marketing</p><h2>One city name. Very different listings.</h2></div>
      <p class="lede">Realtor.com data for October 2026 shows how widely ZIPs labeled Saint Petersburg vary. These are housing figures. They do not measure demand for staging.</p>
    </div>
    <div class="stats">
      <div class="stat"><b>3,049</b><span>active listings across 16 Saint Petersburg postal ZIPs</span></div>
      <div class="stat"><b>60–133</b><span>days, the range of median days on market by ZIP</span></div>
      <div class="stat"><b>$219.5K–$1.2M</b><span>the range of median list prices by ZIP</span></div>
      <div class="stat"><b>26%</b><span>of city housing units are in buildings with 10 or more units (ACS 2020–2024)</span></div>
    </div>
    <p class="small" style="margin-top:20px">Postal ZIPs are not city limits. StageLiora works remotely and has no office in St. Petersburg.{isLive('/locations/st-petersburg-fl/') && <> <a href={url('/locations/st-petersburg-fl/')}>See the St. Petersburg guide</a>.</>}</p>
  </div>
</section>

<section class="section">
  <div class="wrap two-col">
    <div><p class="eyebrow">Questions</p><h2>What people ask first</h2>{isLive('/faq/') && <div class="cta-row"><LinkButton href="/faq/" label="See All FAQs" /></div>}</div>
    <Faq items={faqs} open />
  </div>
</section>
<Lightbox />
<Cta />

<style>
  .home-research { max-width: 80ch; margin: 18px 0 0; color: var(--muted); }
  .home-vo__card { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .home-vo__card h3 { margin: 6px 0 0; }
  .home-vo__card p { margin: 0; }
  .home-vo__card > :last-child:not(p) { margin-top: auto; align-self: flex-start; }
  .home-vo__more { margin: 24px 0 0; }
</style>
