---
import { url } from '../lib/url.ts';
import MediaImage from '../components/MediaImage.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { styles } from '../data/taxonomy.ts';
import { getMedia } from '../data/media.ts';
import { isLive } from '../data/routes.ts';
---
<PageHero path="/design-styles/" eyebrow="Design styles" h1="Choose a style for the house, not the moodboard" lede="The best staging style is the one that suits the architecture in the photo and the people likely to buy it. Here are eight directions to start from." />
<section class="section">
  <div class="wrap">
    <div class="gal">
      {styles.map((s) => {
        const img = getMedia(`lib-${s.id}-living-room`);
        const page = `/design-styles/${s.id}/`;
        const lib = isLive('/design-library/') ? `/design-library/?style=${s.id}` : null;
        const href = s.hasPage && isLive(page) ? page : lib;
        return (
          <article class="gal__item">
            {href ? <a href={url(href)} aria-label={`${s.name} style`}><MediaImage media={img} /></a> : <MediaImage media={img} />}
            <h2 style="font-size:1.4rem;margin-top:12px">{s.name}</h2>
            <p class="gal__meta">{s.note}</p>
            <p class="gal__meta">{s.materials}</p>
            {href && <a class="textlink small" href={url(href)}>{s.hasPage && isLive(page) ? `About ${s.name.toLowerCase()} staging` : 'See in the Design Library'}</a>}
          </article>
        );
      })}
    </div>
    <p class="small muted" style="margin-top:22px">Images illustrate each direction and are not completed client projects. These styles are not yet available to order.</p>
  </div>
</section>
<Cta />
