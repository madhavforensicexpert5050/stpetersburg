# preview (default): every route builds, nothing is indexable, gated pages show draft notices.
# production: run "npm run build:production". Only routes with documented approval in src/data/approvals.ts build.
SITE_MODE=preview
# Set automatically by build:production from the owner approvals in src/data/approvals.ts.
INDEXING=off
# Tested HTTPS endpoint that accepts the JSON quote payload (see docs/stageliora-deployment-readiness.md).
# While empty the form never claims to have sent anything; it offers a prefilled email instead.
PUBLIC_FORM_ENDPOINT=

# Server-side only. Set in the host's secret store. Never prefix with PUBLIC_ or commit.
# RESEND_API_KEY=
# INQUIRY_FROM=StageLiora Website <inquiries@verified-sending-domain.example>
# INQUIRY_TO=dev@devendergarg.com
# ALLOWED_ORIGIN=https://st.petersburg.stageliora.com
# PREVIEW_PASSWORD=   (required on any preview deployment)
