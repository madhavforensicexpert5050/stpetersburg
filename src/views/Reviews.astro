---
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
---
<PageHero path="/reviews/" eyebrow="Reviews" h1="No reviews yet" lede="We have no customer reviews to show. We will not write our own or pay for favorable ones." />
<section class="section">
  <div class="wrap">
    <div class="empty">
      <h2>This page will hold genuine reviews only</h2>
      <p>Each one will come from a real customer, be published with their permission, and appear as they wrote it. Until then, this page stays empty.</p>
    </div>
  </div>
</section>
<Cta />
