---
import MediaImage from './MediaImage.astro';
import { getPair, isIllustration, illustrationNote, aiCompareNote } from '../data/media.ts';
interface Props { pair: string; eager?: boolean; animate?: boolean; hideCaption?: boolean }
const { pair, eager = false, animate = false } = Astro.props;
const { before, after } = getPair(pair);
const illustrative = isIllustration(before) || isIllustration(after);
const synthetic = before.rights === 'ai-generated' && after.rights === 'ai-generated';
---
<figure class:list={['compare-wrap', { 'anim-reveal': animate }]} data-compare>
  <div class="compare">
    <MediaImage media={before} eager={eager} sizes={eager ? '(max-width: 767px) 100vw, 1200px' : undefined} />
    <MediaImage media={after} class="compare__after" eager={eager} sizes={eager ? '(max-width: 767px) 100vw, 1200px' : undefined} />
    <span class="compare__tag compare__tag--b">Before{illustrative && !synthetic && <span class="compare__tag-x"> · Illustrative room</span>}</span>
    <span class="compare__tag compare__tag--a">After{illustrative && <span class="compare__tag-x">{synthetic ? ' · AI concept' : ' · Design concept'}</span>}</span>
    <span class="compare__line" aria-hidden="true"></span>
    <span class="compare__knob" aria-hidden="true">↔</span>
    <input type="range" min="0" max="100" value="50" step="1" aria-label={`Compare before and after: ${before.label} and ${after.label}`} aria-valuetext="50 percent" />
  </div>
  <figcaption>
    <p>{synthetic ? aiCompareNote : illustrative ? illustrationNote : after.caption}</p>
    <button type="button" class="mini-btn compare-noscript-hide" data-compare-toggle aria-pressed="false">Side by side</button>
  </figcaption>
</figure>
