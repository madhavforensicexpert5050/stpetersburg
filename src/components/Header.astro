---
import { url } from '../lib/url.ts';
import { services } from '../data/services.ts';
import { business } from '../data/business.ts';
import { isLive } from '../data/routes.ts';
import BrandLogo from './BrandLogo.astro';
const { path } = Astro.props as { path: string };
const listing = services.filter((s) => s.track === 'listing-editing' && isLive(s.path));
const concept = services.filter((s) => s.track === 'concept-visualization' && isLive(s.path));
const showServices = listing.length + concept.length > 0 || isLive('/services/');
const onServices = path === '/services/' || services.some((s) => s.path === path);
// Order: Home | Services (menu, inserted after Home) | Real Estate | How It Works | Portfolio | Pricing
const home = { href: '/', label: 'Home' };
const rest = [
  { href: '/for-real-estate-agents/', label: 'Real Estate' },
  { href: '/how-it-works/', label: 'How It Works' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/pricing/', label: 'Pricing' },
].filter((x) => isLive(x.href));
---
<header class="site-header">
  <div class="wrap head-in">
    <BrandLogo variant="header" />
    <nav class="nav" id="site-nav" aria-label="Main">
      {isLive(home.href) && <a href={url(home.href)} aria-current={path === home.href ? 'page' : undefined}>{home.label}</a>}
      {showServices && (
        <details data-nav-menu data-active={onServices ? '' : undefined}>
          <summary>Services</summary>
          <div class="mega">
            <div>
              <h3>Listing photo edits</h3>
              {listing.map((s) => <a href={url(s.path)} aria-current={path === s.path ? 'page' : undefined}>{s.name}</a>)}
            </div>
            <div>
              <h3>Concept visualizations</h3>
              {concept.map((s) => <a href={url(s.path)} aria-current={path === s.path ? 'page' : undefined}>{s.name}</a>)}
              {isLive('/services/') && <a href={url('/services/')} aria-current={path === '/services/' ? 'page' : undefined}><strong>All services</strong></a>}
            </div>
          </div>
        </details>
      )}
      {rest.map((x) => <a href={url(x.href)} aria-current={path === x.href ? 'page' : undefined}>{x.label}</a>)}
    </nav>
    <div class="head-cta">
      <a class="head-call" href={business.phoneHref} aria-label={`Call StageLiora at ${business.phoneDisplay}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        <span class="head-call__num">{business.phoneDisplay}</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>Menu</button>
    </div>
  </div>
</header>
