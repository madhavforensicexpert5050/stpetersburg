---
/**
 * Pricing (V12): hero, four cards, comparison, cost factors, project expectations, FAQ, contact CTA.
 * Figures come only from approvals.planPricing via src/data/pricing-plans.ts. Proposed V12 rates are
 * never rendered. No crossed-out prices, bundle totals or checkout links. Card labels come from
 * planBadge(); "Save X%" badges stay off until approvals.pricingClaims.bundleSavings is recorded.
 */
import { url } from '../lib/url.ts';
import Crumbs from '../components/Crumbs.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import CallButton from '../components/CallButton.astro';
import { pricing } from '../data/content.ts';
import { plans, anyPlanPriced, headline, rateText, approvedTerm, planBadge, savingsDisclosure } from '../data/pricing-plans.ts';
import { business } from '../data/business.ts';
import { isLive } from '../data/routes.ts';
const contactHref = isLive('/contact/') ? url('/contact/') : business.emailHref;
const priced = anyPlanPriced();
const confirm = 'Confirmed before you commit';

// FAQs: answers mention a figure only when that figure is approved.
const payg = rateText('pay-as-you-go'), ess = rateText('essential-bundle'), plus = rateText('plus-bundle'), da = rateText('dedicated-assistance');
const faqs = [
  { q: 'How much does a virtual staging image cost?', a: payg ? `Pay As You Go is ${payg}.${ess ? ` The Essential Bundle is ${ess}` : ''}${plus ? ` and the Plus Bundle is ${plus}` : ''}${ess || plus ? ' when photos are staged as a set.' : ''} The exact cost for your photos is confirmed before any work begins.` : 'It depends on the service, the number of photos and the work each room needs. Rates are not listed on the site yet, so ask about your listing directly and the cost will be confirmed before any work begins.' },
  { q: 'How does Pay As You Go work?', a: `Each image is priced on its own${payg ? `, at ${payg}` : ''}. It suits a single room or a few photos, and the scope and cost are agreed before any work starts.` },
  { q: 'What is the difference between Essential and Plus?', a: `Both price photos as a set instead of one by one. Plus is meant for larger sets or several listings${ess && plus ? `, with a lower rate (${plus} against ${ess})` : ', with a lower per-photo rate'}. Bundle sizes and terms are set out in writing before any payment.` },
  { q: 'How are bundled images billed?', a: 'Bundle billing, including quantity, any prepayment and how unused images are handled, is agreed in writing before any payment. Nothing is billed through this website.' },
  { q: 'What is Dedicated Assistance?', a: `An option for people with ongoing property-image needs who want to talk through requirements, scope and suitable services directly with StageLiora${da ? `. It is ${da}` : ''}. Call or use the Contact page to discuss it.` },
  { q: 'How do I discuss a project?', a: 'Call StageLiora or use the Contact page. Have the number of photos, the rooms and where the images will be used ready.' },
  ...pricing.faqs.filter((f) => /What affects the cost|How are revisions handled|Are design visualizations/.test(f.q)),
  { q: 'How are payments collected?', a: 'There is no online checkout or prepayment on this site. How to pay is set out in writing before any work starts. Please do not send card details by email or through a form.' },
];
---
<section class="pricing-hero">
  <div class="wrap">
    <Crumbs path="/pricing/" />
    <h1>Virtual Staging Pricing</h1>
    <p class="lede">Straightforward pricing options for individual images, bundled property photos and ongoing visual presentation needs.</p>
  </div>
</section>

<section class="section section--tight pricing-plans">
  <div class="wrap">
    <h2 class="visually-hidden">Pricing options</h2>
    <ul class="plan-grid">
      {plans.map((p) => {
        const h = headline(p.planId);
        const prepay = approvedTerm(p.planId, 'prepay');
        const badge = planBadge(p.planId);
        return (
          <li class:list={['plan', { 'plan--assist': p.variant === 'assist' }]}>
            {badge && <p class:list={['plan__badge', `plan__badge--${badge.tone}`]}>{badge.text}{badge.srText && <span class="visually-hidden"> {badge.srText}</span>}</p>}
            <h3 class="plan__name">{p.planName}</h3>
            <p class="plan__sub">{p.subtitle}</p>
            <div class="plan__price">
              {h ? <p class="plan__amount"><span>{h.amount}</span> <small>{h.unit}</small></p> : <p class="plan__amount plan__amount--model">{p.model}</p>}
              <p class="plan__note">{prepay ? `Prepay ${prepay}` : p.modelNote}</p>
            </div>
            <ul class="plan__features">{p.features.map((f) => <li>{f}</li>)}</ul>
            <div class="plan__cta">
              {p.ctaDestination === 'tel'
                ? <><CallButton /><a class="plan__secondary" href={contactHref}>Contact Us</a></>
                : <a class="btn plan__btn" href={contactHref}>{p.ctaLabel}</a>}
            </div>
          </li>
        );
      })}
    </ul>
    {savingsDisclosure() && <p class="plan-footnote plan-footnote--savings">{savingsDisclosure()}</p>}
    <p class="plan-footnote">{priced ? 'Prices are in US dollars, per finished image unless stated. Bundle rates apply to photo sets under bundle terms agreed in writing, not to single images. The exact cost for your photos is confirmed before any work begins. Nothing can be purchased online.' : 'Rates are not listed on the site yet. Ask about pricing for your listing by phone or through the Contact page. Nothing can be purchased online.'}</p>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Compare</p><h2>Pricing options side by side</h2></div>
    <div class="table-wrap compare-plans" tabindex="0" role="region" aria-label="Pricing options compared">
      <table>
        <caption class="visually-hidden">How the four pricing options compare</caption>
        <thead><tr><td></td>{plans.map((p) => <th scope="col">{p.planName}</th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">Price</th>{plans.map((p) => { const h = headline(p.planId); return <td>{h ? `${h.amount} ${h.unit}` : p.ctaDestination === 'tel' ? 'Contact for details' : confirm}</td>; })}</tr>
          <tr><th scope="row">Pricing unit</th>{plans.map((p) => <td>{p.compare.unit}</td>)}</tr>
          <tr><th scope="row">Intended use</th>{plans.map((p) => <td>{p.compare.use}</td>)}</tr>
          <tr><th scope="row">Prepayment</th>{plans.map((p) => <td>{approvedTerm(p.planId, 'prepay') ?? (p.ctaDestination === 'tel' ? 'Discussed directly' : confirm)}</td>)}</tr>
          <tr><th scope="row">Minimum photos</th>{plans.map((p) => <td>{approvedTerm(p.planId, 'minimum') ?? (p.ctaDestination === 'tel' ? 'Discussed directly' : confirm)}</td>)}</tr>
          <tr><th scope="row">Included credits</th>{plans.map((p) => <td>{approvedTerm(p.planId, 'credits') ?? (p.ctaDestination === 'tel' ? 'Discussed directly' : 'None stated')}</td>)}</tr>
          <tr><th scope="row">How to ask</th>{plans.map((p) => <td>{p.ctaDestination === 'tel' ? <a href={business.phoneHref}>Call StageLiora</a> : <a href={contactHref}>Contact page</a>}</td>)}</tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section--wall">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Cost factors</p><h2>What affects virtual staging pricing?</h2></div>
      <p class="lede">Two photos that look alike can need very different amounts of work. These are the things that decide it.</p>
    </div>
    <div class="grid grid--3">
      {pricing.factors.map((f) => <div class="card card--flat"><h3>{f.h}</h3><p>{f.b}</p></div>)}
    </div>
  </div>
</section>

<section class="section" id="planning" aria-labelledby="planning-h">
  <div class="wrap two-col plan-cost">
    <div>
      <p class="eyebrow">Budget</p>
      <h2 id="planning-h">{pricing.planning.h}</h2>
      <p class="lede" style="margin-top:16px">{pricing.planning.intro}</p>
      {pricing.planning.example && <p class="plan-cost__example">{pricing.planning.example}</p>}
      {isLive('/guides/virtual-staging-for-real-estate-agents/') && <p style="margin-top:18px"><a class="textlink" href={url('/guides/virtual-staging-for-real-estate-agents/')}>Choosing which rooms to stage</a></p>}
    </div>
    <ol class="plan-cost__steps">
      {pricing.planning.steps.map((s) => <li><h3>{s.h}</h3><p>{s.b}</p></li>)}
    </ol>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Before you start</p><h2>Know what goes into your project</h2></div>
    <div class="grid grid--4 expect">
      {pricing.expect.map((x) => (
        <div class="card">
          <h3>{x.h}</h3>
          <p>{x.b}</p>
          {x.href && isLive(x.href) && <a class="textlink" href={url(x.href)}>{x.link}</a>}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--wall">
  <div class="wrap two-col">
    <div><p class="eyebrow">Questions</p><h2>Pricing FAQ</h2>{isLive('/guides/virtual-staging-cost/') && <p style="margin-top:14px"><a class="textlink" href={url('/guides/virtual-staging-cost/')}>What virtual staging costs across the market</a></p>}</div>
    <Faq items={faqs} />
  </div>
</section>

<Cta h="Talk to StageLiora about Dedicated Assistance" p="Discuss your property images, ongoing requirements and the type of presentation you are considering." />

<style>
  .plan-cost { align-items: start; }
  .plan-cost__example { margin: 18px 0 0; padding: 16px 18px; background: #fbf7ee; border: 1px solid #efe4c9; border-left: 3px solid var(--sun); border-radius: 6px; color: var(--ink); max-width: 62ch; }
  .plan-cost__steps { list-style: none; margin: 0; padding: 0; counter-reset: plancost; }
  .plan-cost__steps li { counter-increment: plancost; position: relative; padding: 18px 0 18px 46px; border-top: 1px solid var(--line); }
  .plan-cost__steps li:first-child { border-top: 3px solid var(--ink); }
  .plan-cost__steps li::before { content: counter(plancost); position: absolute; left: 0; top: 18px; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff; font: 650 .9rem/30px var(--text); text-align: center; }
  .plan-cost__steps h3 { font-size: 1.15rem; margin: 0 0 6px; }
  .plan-cost__steps p { margin: 0; }
</style>
