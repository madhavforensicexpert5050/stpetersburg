---
import PageHero from '../components/PageHero.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import Cta from '../components/Cta.astro';
import { services, trackLabel, availabilityLabel } from '../data/services.ts';
import { isLive, isPreview } from '../data/routes.ts';
const shown = services.filter((s) => isPreview || isLive(s.path));
const listing = shown.filter((s) => s.track === 'listing-editing');
const concept = shown.filter((s) => s.track === 'concept-visualization');
const h1 = isPreview ? 'Nine image services, sorted by what they are for' : 'Image services, sorted by what they are for';
---
<PageHero path="/services/" eyebrow="Services" h1={h1} lede={concept.length ? 'Some edits are meant for listing photos. Others are for planning a change. Each service below says which it is, and what Stellar MLS says about it.' : 'Each service below explains what it changes, what it leaves alone, and what Stellar MLS says about it.'} />
{listing.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Listing photo edits</p><h2>For showing the property as it is</h2></div>
      <ServiceTiles only={listing.map((s) => s.slug)} />
    </div>
  </section>
)}
{concept.length > 0 && (
  <section class="section section--wall">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Concept visualizations</p><h2>For planning what could change</h2><p class="lede">These images show ideas. They should not be presented as the property's current condition, and in Stellar MLS they are not listing photos.</p></div>
      <ServiceTiles only={concept.map((s) => s.slug)} />
    </div>
  </section>
)}
<section class="section">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">At a glance</p><h2>Services and Stellar MLS listing use</h2></div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Services and Stellar MLS listing use">
      <table>
        <caption>Summary of Stellar MLS Article 04.04 and photo rules, read November 5, 2026. Not legal advice.</caption>
        <thead><tr><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Stellar listing use</th>{isPreview && <th scope="col">Status</th>}</tr></thead>
        <tbody>
          {shown.map((s) => <tr><td>{isLive(s.path) ? <a href={s.path}>{s.name}</a> : s.name}</td><td>{trackLabel[s.track]}</td><td>{s.stellar.label}</td>{isPreview && <td>{availabilityLabel(s.slug)}</td>}</tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>
<Cta />
