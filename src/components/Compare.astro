---
import MediaImage from './MediaImage.astro';
import { getPair, isIllustration, type MediaItem } from '../data/media.ts';
/**
 * Before/after slider. Pass `pair` (resolved with getPair), or `before` and `after` directly (Portfolio Section 3,
 * where site.ts swaps the after image through [data-compare-after]). `label` replaces the slider's accessible name.
 */
interface Props { pair?: string; before?: MediaItem; after?: MediaItem; label?: string; eager?: boolean; animate?: boolean; hideCaption?: boolean }
const { pair, eager = false, animate = false, label } = Astro.props;
const { before, after } = Astro.props.before && Astro.props.after ? { before: Astro.props.before, after: Astro.props.after } : getPair(pair!);
const illustrative = isIllustration(before) || isIllustration(after);
const synthetic = before.rights === 'ai-generated' && after.rights === 'ai-generated';
const swappable = Boolean(Astro.props.after);
---
<figure class:list={['compare-wrap', { 'anim-reveal': animate }]} data-compare>
  <div class="compare">
    <MediaImage media={before} eager={eager} sizes={eager ? '(max-width: 767px) 100vw, 1200px' : undefined} />
    <MediaImage media={after} class="compare__after" eager={eager} sizes={eager ? '(max-width: 767px) 100vw, 1200px' : undefined} compareAfter={swappable} />
    <span class="compare__tag compare__tag--b">Before{illustrative && !synthetic && <span class="compare__tag-x"> · Illustrative room</span>}</span>
    <span class="compare__tag compare__tag--a">After{illustrative && !synthetic && <span class="compare__tag-x"> · Design concept</span>}</span>
    <span class="compare__line" aria-hidden="true"></span>
    <span class="compare__knob" aria-hidden="true">↔</span>
    <input type="range" min="0" max="100" value="50" step="1" aria-label={label ?? (synthetic ? `Compare the original room and the AI-created visualization: ${before.label} and ${after.label}` : `Compare before and after: ${before.label} and ${after.label}`)} aria-valuetext="50 percent" />
  </div>
  <figcaption>
    {!illustrative && after.caption && <p>{after.caption}</p>}
    <button type="button" class="mini-btn compare-noscript-hide" data-compare-toggle aria-pressed="false">Side by side</button>
  </figcaption>
</figure>
